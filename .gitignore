# Python
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
.installed.cfg

# Virtual environments
venv/
env/
ENV/
.venv/

# Jupyter
.ipynb_checkpoints/

# Data — raw only (trop lourd pour git)
data/raw/

# Models binaires — trop lourds pour Git, régénérés par src/save_model.py
models/*.pkl
models/*.joblib
# Exception : le scaler est petit et ne peut pas être régénéré sans le CSV brut
# (non versionné) — on le committe directement pour que l'API fonctionne
# immédiatement après un clone.
!models/scaler.pkl

# Reports — ignorer les fichiers générés, garder la structure
reports/figures/*.png
reports/figures/*.jpg
reports/figures/*.svg

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Livrable final
*.zip

# Fichiers temporaires Office (verrous PowerPoint/Word)
~$*
